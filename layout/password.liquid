<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} — {{ 'password.title' | t }}</title>
  {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{% endif %}
  {% render 'fonts' %}
  {{ content_for_header }}
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    body{background:#0F1A2B;color:#fff;font-family:'Barlow Condensed',sans-serif;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px 20px;}
    @keyframes goldFlow{0%{background-position:100% 0}100%{background-position:-100% 0}}
    .logo{font-family:'Bebas Neue',sans-serif;font-size:clamp(48px,10vw,96px);letter-spacing:8px;background:linear-gradient(110deg,#A88B4A 0%,#E8C97A 30%,#C6A962 50%,#E8C97A 70%,#A88B4A 100%);background-size:300% 100%;animation:goldFlow 3.5s linear infinite;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:12px;}
    .sub{font-size:12px;letter-spacing:6px;text-transform:uppercase;color:rgba(255,255,255,.65);margin-bottom:40px;}
    .msg{font-size:16px;color:rgba(255,255,255,.7);line-height:1.6;max-width:440px;margin:0 auto 32px;}
    .pw-form{display:flex;gap:0;max-width:360px;width:100%;margin:0 auto;}
    .pw-input{flex:1;min-width:0;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.18);border-right:none;color:#fff;font-family:'Barlow Condensed',sans-serif;font-size:14px;padding:13px 16px;}
    .pw-input::placeholder{color:rgba(255,255,255,.45);}
    .pw-input:focus{outline:2px solid #C6A962;outline-offset:-2px;}
    .pw-btn{background:linear-gradient(110deg,#A88B4A,#E8C97A,#C6A962,#E8C97A,#A88B4A);background-size:300% 100%;color:#0F1A2B;border:none;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:11px;letter-spacing:3px;text-transform:uppercase;padding:13px 22px;cursor:pointer;white-space:nowrap;}
    .pw-btn:focus-visible{outline:2px solid #fff;outline-offset:2px;}
    .pw-err{color:#ff8a8a;font-size:13px;margin-top:12px;}
    .pw-ok{color:#7be0a6;font-size:14px;margin-top:12px;}
    .pw-sep{width:44px;height:1px;background:rgba(198,169,98,.3);margin:40px auto;}
    .visually-hidden{position:absolute!important;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}
    @media (prefers-reduced-motion:no-preference){.pw-btn{animation:goldFlow 3.5s linear infinite;}}
    @media (prefers-reduced-motion:reduce){.logo{animation:none;}}
  </style>
</head>
<body>
  <main>{{ content_for_layout }}</main>
</body>
</html>
