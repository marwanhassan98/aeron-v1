<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} — Coming Soon</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Barlow+Condensed:wght@400;600;700&display=swap" rel="stylesheet">
  {{ content_for_header }}
  {{ content_for_layout }}
  <style>
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
    body{background:#0F1A2B;color:#fff;font-family:'Barlow Condensed',sans-serif;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px 20px;}
    @keyframes goldFlow{0%{background-position:100% 0}100%{background-position:-100% 0}}
    .logo{font-family:'Bebas Neue',sans-serif;font-size:clamp(48px,10vw,96px);letter-spacing:8px;background:linear-gradient(110deg,#A88B4A 0%,#E8C97A 30%,#C6A962 50%,#E8C97A 70%,#A88B4A 100%);background-size:300% 100%;animation:goldFlow 3.5s linear infinite;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:12px;}
    .sub{font-size:12px;letter-spacing:6px;text-transform:uppercase;color:rgba(255,255,255,.35);margin-bottom:48px;}
    .pw-form{display:flex;gap:0;max-width:360px;width:100%;}
    .pw-input{flex:1;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-right:none;color:#fff;font-family:'Barlow Condensed',sans-serif;font-size:14px;padding:13px 16px;outline:none;}
    .pw-input::placeholder{color:rgba(255,255,255,.3);}
    .pw-btn{background:linear-gradient(110deg,#A88B4A,#E8C97A,#C6A962,#E8C97A,#A88B4A);background-size:300% 100%;animation:goldFlow 3.5s linear infinite;color:#0F1A2B;border:none;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:11px;letter-spacing:3px;text-transform:uppercase;padding:13px 22px;cursor:pointer;white-space:nowrap;}
  </style>
</head>
<body>
  <div style="display:none">{{ content_for_layout }}</div>
  <div class="logo">AERON</div>
  <div class="sub">Rise Above Everything — Coming Soon</div>
  {% form 'storefront_password' %}
    <div class="pw-form">
      <input class="pw-input" type="password" name="password" placeholder="Enter password" autocomplete="current-password">
      <button type="submit" class="pw-btn">Enter</button>
    </div>
    {% if form.errors %}<p style="color:#ff6b6b;font-size:13px;margin-top:12px;">Wrong password. Try again.</p>{% endif %}
  {% endform %}
</body>
</html>
