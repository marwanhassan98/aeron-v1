{%- liquid
  assign base_total = settings.kit_jersey_10 | times: 20
  if settings.kit_free_ship_qty <= 20
    assign start_ship = 0
  else
    assign start_ship = settings.kit_ship_small
  endif
  assign start_total = base_total | plus: start_ship
  assign start_unit = start_total | times: 100 | divided_by: 20
-%}
<script type="application/json" id="kitPricing">
  {
    "jersey": { "10": {{ settings.kit_jersey_10 | json }}, "50": {{ settings.kit_jersey_50 | json }}, "100": {{ settings.kit_jersey_100 | json }}, "200": {{ settings.kit_jersey_200 | json }}, "500": {{ settings.kit_jersey_500 | json }} },
    "set": { "10": {{ settings.kit_set_10 | json }}, "50": {{ settings.kit_set_50 | json }}, "100": {{ settings.kit_set_100 | json }}, "200": {{ settings.kit_set_200 | json }}, "500": {{ settings.kit_set_500 | json }} },
    "names": {{ settings.kit_names | json }}, "sponsor": {{ settings.kit_sponsor | json }}, "emb": {{ settings.kit_emb | json }}, "socks": {{ settings.kit_socks | json }},
    "ship": { "small": {{ settings.kit_ship_small | json }}, "30": {{ settings.kit_ship_30 | json }}, "50": {{ settings.kit_ship_50 | json }}, "free": {{ settings.kit_free_ship_qty | json }} }
  }
</script>
<script type="application/json" id="kitStrings">
  {"base_jersey": {{ 'kits.js.base_jersey' | t | json }}, "base_set": {{ 'kits.js.base_set' | t | json }}, "per_jersey": {{ 'kits.js.per_jersey' | t | json }}, "per_set": {{ 'kits.js.per_set' | t | json }}, "free": {{ 'kits.js.free' | t | json }}, "unit_note": {{ 'kits.js.unit_note' | t | json }}, "ship_msg": {{ 'kits.js.ship_msg' | t | json }}, "sending": {{ 'kits.js.sending' | t | json }}}
</script>
<style>
.kh-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center;max-width:1100px;margin:0 auto;position:relative;z-index:2;}
.build-layout{display:grid;grid-template-columns:1fr 1fr;gap:76px;align-items:start;max-width:1100px;margin:56px auto 0;}
.proj-layout{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start;max-width:1100px;margin:56px auto 0;}
@media(max-width:900px){.kh-grid,.build-layout,.proj-layout{grid-template-columns:1fr!important;gap:40px!important;}.opt-grid-4{grid-template-columns:1fr 1fr!important;}}
</style>

<!-- APEX HEADER -->
<section style="padding:80px 60px;background:#0F1A2B;position:relative;overflow:hidden;">
  <div style="position:absolute;font-family:'Bebas Neue',sans-serif;font-size:340px;color:rgba(255,255,255,.022);right:-20px;top:50%;transform:translateY(-50%);pointer-events:none;letter-spacing:-14px;line-height:1;">APEX</div>
  <div class="kh-grid">
    <div>
      <div style="font-family:'Barlow Condensed',sans-serif;font-size:10px;font-weight:700;letter-spacing:6px;text-transform:uppercase;color:#C6A962;margin-bottom:12px;">{{ section.settings.tier_label | default: "Tier 01 — Airborne Series" }}</div>
      <h1 style="font-family:'Bebas Neue',sans-serif;font-size:clamp(72px,11vw,148px);letter-spacing:6px;color:#fff;line-height:.85;margin-bottom:16px;">APEX</h1>
      <div style="font-family:'Barlow Condensed',sans-serif;font-size:16px;color:rgba(255,255,255,.66);letter-spacing:2px;line-height:1.65;margin-bottom:28px;">{{ section.settings.kit_tagline | default: "One kit. Everything premium." }}</div>
      <div style="display:flex;flex-direction:column;gap:9px;margin-bottom:30px;">
        <div style="display:flex;align-items:center;gap:11px;font-family:'Barlow Condensed',sans-serif;font-size:14px;color:rgba(255,255,255,.66);"><span style="color:#C6A962;font-size:8px;flex-shrink:0;">&#10022;</span>{{ 'kits.feat_sublimation' | t }}</div>
        <div style="display:flex;align-items:center;gap:11px;font-family:'Barlow Condensed',sans-serif;font-size:14px;color:rgba(255,255,255,.66);"><span style="color:#C6A962;font-size:8px;flex-shrink:0;">&#10022;</span>{{ 'kits.feat_logo' | t }}</div>
        <div style="display:flex;align-items:center;gap:11px;font-family:'Barlow Condensed',sans-serif;font-size:14px;color:rgba(255,255,255,.66);"><span style="color:#C6A962;font-size:8px;flex-shrink:0;">&#10022;</span>{{ 'kits.feat_crest' | t }}</div>
        <div style="display:flex;align-items:center;gap:11px;font-family:'Barlow Condensed',sans-serif;font-size:14px;color:rgba(255,255,255,.66);"><span style="color:#C6A962;font-size:8px;flex-shrink:0;">&#10022;</span>{{ 'kits.feat_sponsors' | t }}</div>
        <div style="display:flex;align-items:center;gap:11px;font-family:'Barlow Condensed',sans-serif;font-size:14px;color:rgba(255,255,255,.66);"><span style="color:#C6A962;font-size:8px;flex-shrink:0;">&#10022;</span>{{ 'kits.feat_collar' | t }}</div>
        <div style="display:flex;align-items:center;gap:11px;font-family:'Barlow Condensed',sans-serif;font-size:14px;color:rgba(255,255,255,.66);"><span style="color:#C6A962;font-size:8px;flex-shrink:0;">&#10022;</span>{{ 'kits.feat_shipping' | t: qty: settings.kit_free_ship_qty }}</div>
      </div>
      <div style="display:flex;align-items:baseline;gap:10px;padding-top:22px;border-top:1px solid rgba(198,169,98,.12);margin-bottom:26px;">
        <span style="font-family:'Barlow Condensed',sans-serif;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:rgba(255,255,255,.66);">{{ section.settings.price_from }}</span>
        <span style="font-family:'Bebas Neue',sans-serif;font-size:58px;line-height:1;" class="gold-text">${{ settings.kit_jersey_10 }}</span>
        <span style="font-family:'Barlow Condensed',sans-serif;font-size:11px;color:rgba(255,255,255,.66);letter-spacing:2px;">{{ section.settings.price_unit }}</span>
      </div>
      <a href="#build" class="aeron-btn" style="padding:14px 38px;font-size:11px;">{{ 'kits.build_cta' | t }}</a>
    </div>
    <div style="display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.03);border:1px solid rgba(198,169,98,.1);min-height:360px;">
      {% if section.settings.kit_image != blank %}
        {{ section.settings.kit_image | image_url: width: 1200 | image_tag: widths: '500, 700, 900, 1200', sizes: '(max-width: 900px) 100vw, 510px', alt: 'APEX kit', style: 'width:100%;height:100%;object-fit:cover;' }}
      {% else %}
        <div style="text-align:center;padding:40px;opacity:.3;">
          <div style="font-family:'Bebas Neue',sans-serif;font-size:48px;letter-spacing:6px;color:#C6A962;">APEX</div>
          {% if request.design_mode %}<div style="font-family:'Barlow Condensed',sans-serif;font-size:11px;letter-spacing:3px;color:#fff;margin-top:8px;">Upload kit photo in theme editor</div>{% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<!-- BUILD YOUR KIT -->
<section class="section" id="build" style="padding:100px 60px;">
  <div style="max-width:1100px;margin:0 auto;">
    <div class="reveal">
      <div class="kicker">{{ section.settings.build_kicker | default: "Configure" }}</div>
      <h2 class="heading">{{ section.settings.build_heading | default: "Build Your Kit." }}</h2>
      <div class="gold-bar"></div>
    </div>
    <div style="margin-top:40px;">
      <div class="incl-banner reveal">
        <div class="incl-lbl">{{ section.settings.incl_label | default: "Always included" }}</div>
        <div class="incl-items">{{ section.settings.incl_items | default: "Full sublimation · AERON embroidered logo · TPU raised club crest" }}</div>
      </div>

      <!-- 01 KIT TYPE -->
      <div style="margin-bottom:48px;" class="reveal">
        <div class="cfg-label"><span class="cfg-num">01</span> {{ 'kits.kit_type' | t }}</div>
        <p style="font-family:'Barlow Condensed',sans-serif;font-size:13px;color:rgba(15,26,43,.66);margin-bottom:14px;line-height:1.6;">{{ 'kits.sizes_note_html' | t }}</p>
        <div class="opt-grid-2">
          <div class="opt-card on" onclick="setKit(this,'jersey')" data-kit="jersey">
            <div class="opt-img">
              {% if section.settings.img_jersey != blank %}{{ section.settings.img_jersey | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(max-width: 600px) 50vw, 260px', loading: 'lazy', alt: 'Jersey Only' }}{% else %}<svg width="80" height="100" viewBox="0 0 200 240" fill="none"><defs><linearGradient id="jg1" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#1C2F4A"/><stop offset="100%" stop-color="#0F1A2B"/></linearGradient></defs><path d="M50,40 L20,70 L10,130 L35,135 L35,230 L165,230 L165,135 L190,130 L180,70 L150,40 L130,55 C120,60 80,60 70,55 Z" fill="url(#jg1)"/><path d="M70,55 Q100,70 130,55" fill="rgba(15,26,43,.8)" stroke="rgba(198,169,98,.4)" stroke-width="2"/></svg>{% endif %}
            </div>
            <div class="opt-body"><div class="opt-name">{{ 'kits.jersey_only' | t }}</div><div class="opt-price" id="priceJerseyCard">${{ settings.kit_jersey_10 }} {{ 'kits.js.per_jersey' | t }}</div></div>
          </div>
          <div class="opt-card" onclick="setKit(this,'shorts')" data-kit="shorts">
            <div class="opt-img">
              {% if section.settings.img_shorts != blank %}{{ section.settings.img_shorts | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(max-width: 600px) 50vw, 260px', loading: 'lazy', alt: 'Jersey + Shorts' }}{% else %}<svg width="80" height="100" viewBox="0 0 200 280" fill="none"><defs><linearGradient id="jg2" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#1C2F4A"/><stop offset="100%" stop-color="#0F1A2B"/></linearGradient></defs><path d="M50,40 L20,70 L10,130 L35,135 L35,200 L165,200 L165,135 L190,130 L180,70 L150,40 L130,55 C120,60 80,60 70,55 Z" fill="url(#jg2)"/><path d="M70,55 Q100,70 130,55" fill="rgba(15,26,43,.8)" stroke="rgba(198,169,98,.4)" stroke-width="2"/><rect x="55" y="205" width="90" height="60" rx="4" fill="url(#jg2)" opacity=".7"/></svg>{% endif %}
            </div>
            <div class="opt-body"><div class="opt-name">{{ 'kits.jersey_shorts' | t }}</div><div class="opt-price" id="priceShortsCard">${{ settings.kit_set_10 }} {{ 'kits.js.per_set' | t }}</div></div>
          </div>
        </div>
      </div>

      <!-- 02 ADD-ONS -->
      <div style="margin-bottom:48px;" class="reveal">
        <div class="cfg-label"><span class="cfg-num">02</span> {{ 'kits.addons' | t }}</div>
        <div class="opt-grid-4">
          <div class="opt-card" onclick="toggleAddon(this,'names')" data-addon="names">
            <div class="opt-img">{% if section.settings.img_names != blank %}{{ section.settings.img_names | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(max-width: 600px) 50vw, 260px', loading: 'lazy', alt: 'Player Names' }}{% else %}<svg width="80" height="80" viewBox="0 0 120 120" fill="none"><rect x="10" y="10" width="100" height="100" fill="#F2F2F2"/><text x="60" y="56" text-anchor="middle" font-family="Orbitron,sans-serif" font-size="28" font-weight="900" fill="#0F1A2B">10</text><text x="60" y="78" text-anchor="middle" font-family="Barlow Condensed,sans-serif" font-size="12" font-weight="700" fill="#0F1A2B" letter-spacing="2">PLAYER</text><rect x="20" y="88" width="80" height="2" fill="rgba(198,169,98,.5)" rx="1"/></svg>{% endif %}</div>
            <div class="opt-body"><div class="opt-name">{{ 'kits.names_numbers' | t }}</div><div class="opt-price">+${{ settings.kit_names }} {{ 'kits.js.per_jersey' | t }}</div></div>
          </div>
          <div class="opt-card" onclick="toggleAddon(this,'spon')" data-addon="spon">
            <div class="opt-img">{% if section.settings.img_sponsor != blank %}{{ section.settings.img_sponsor | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(max-width: 600px) 50vw, 260px', loading: 'lazy', alt: 'Sponsor Logo' }}{% else %}<svg width="80" height="80" viewBox="0 0 120 120" fill="none"><rect x="10" y="10" width="100" height="100" fill="#F2F2F2"/><rect x="25" y="38" width="70" height="44" rx="3" fill="#0F1A2B" opacity=".9"/><text x="60" y="66" text-anchor="middle" font-family="Barlow Condensed,sans-serif" font-size="10" font-weight="700" fill="rgba(198,169,98,.9)" letter-spacing="2">SPONSOR</text></svg>{% endif %}</div>
            <div class="opt-body"><div class="opt-name">{{ 'kits.sponsor_upgrade' | t }}</div><div class="opt-price">+${{ settings.kit_sponsor }} {{ 'kits.per_logo' | t }}</div><div class="opt-note">{{ 'kits.sponsor_free' | t }}</div></div>
          </div>
          <div class="opt-card" onclick="toggleAddon(this,'emb')" data-addon="emb">
            <div class="opt-img">{% if section.settings.img_emb != blank %}{{ section.settings.img_emb | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(max-width: 600px) 50vw, 260px', loading: 'lazy', alt: 'Embroidered Crest' }}{% else %}<svg width="80" height="80" viewBox="0 0 120 120" fill="none"><rect x="10" y="10" width="100" height="100" fill="#F2F2F2"/><ellipse cx="60" cy="58" rx="28" ry="32" fill="#0F1A2B"/><ellipse cx="60" cy="58" rx="21" ry="25" fill="none" stroke="rgba(198,169,98,.7)" stroke-width="1.5" stroke-dasharray="3,2"/><text x="60" y="63" text-anchor="middle" font-family="Orbitron,sans-serif" font-size="11" font-weight="900" fill="rgba(198,169,98,.9)">FC</text></svg>{% endif %}</div>
            <div class="opt-body"><div class="opt-name">{{ 'kits.emb_crest' | t }}</div><div class="opt-price">+${{ settings.kit_emb }} {{ 'kits.js.per_jersey' | t }}</div></div>
          </div>
          <div class="opt-card" onclick="toggleAddon(this,'socks')" data-addon="socks">
            <div class="opt-img">{% if section.settings.img_socks != blank %}{{ section.settings.img_socks | image_url: width: 600 | image_tag: widths: '300, 450, 600', sizes: '(max-width: 600px) 50vw, 260px', loading: 'lazy', alt: 'Grip Socks' }}{% else %}<svg width="80" height="100" viewBox="0 0 100 130" fill="none"><path d="M35,10 L35,85 Q35,110 60,118 L80,124 Q95,128 97,115 Q99,102 88,96 L72,86 L72,10 Z" fill="#1C2F4A" opacity=".85"/><rect x="35" y="10" width="37" height="11" rx="2" fill="#C6A962" opacity=".6"/></svg>{% endif %}</div>
            <div class="opt-body"><div class="opt-name">{{ 'kits.socks' | t }}</div><div class="opt-price">+${{ settings.kit_socks }} {{ 'kits.per_pair' | t }}</div></div>
          </div>
        </div>
        <div id="spon-count-wrap" style="display:none;margin-top:3px;background:#F2F2F2;border:1px solid rgba(15,26,43,.07);padding:16px 20px;flex-direction:row;align-items:center;gap:16px;">
          <div style="flex:1;font-family:'Barlow Condensed',sans-serif;font-size:14px;color:rgba(15,26,43,.66);">{{ 'kits.sponsor_count' | t }}</div>
          <div style="display:flex;align-items:center;gap:10px;">
            <button type="button" onclick="adjSpon(-1)" aria-label="{{ 'kits.fewer_logos' | t }}" style="width:30px;height:30px;border:1px solid rgba(15,26,43,.12);background:#fff;font-size:18px;cursor:pointer;line-height:1;display:flex;align-items:center;justify-content:center;">&#8722;</button>
            <div id="spon-count" aria-live="polite" style="font-family:'Orbitron',sans-serif;font-size:18px;font-weight:900;color:#0F1A2B;min-width:20px;text-align:center;">1</div>
            <button type="button" onclick="adjSpon(1)" aria-label="{{ 'kits.more_logos' | t }}" style="width:30px;height:30px;border:1px solid rgba(15,26,43,.12);background:#fff;font-size:18px;cursor:pointer;line-height:1;display:flex;align-items:center;justify-content:center;">+</button>
          </div>
        </div>
      </div>

      <!-- 03 COLLAR -->
      <div style="margin-bottom:48px;" class="reveal">
        <div class="cfg-label"><span class="cfg-num">03</span> {{ 'kits.collar_style' | t }}</div>
        <p style="font-family:'Barlow Condensed',sans-serif;font-size:12px;color:rgba(15,26,43,.66);margin-bottom:14px;">{{ 'kits.collar_note' | t }}</p>
        <div class="opt-grid-3">
          <div class="opt-card on" onclick="setCollar(this,'Round',0)" data-collar="Round"><div class="opt-img"><img src="{{ 'collar-round.webp' | asset_url }}" alt="Round collar" width="600" height="600" loading="lazy"></div><div class="opt-body"><div class="opt-name">{{ 'kits.collar_round' | t }}</div><div class="opt-price">{{ 'kits.included' | t }}</div></div></div>
          <div class="opt-card" onclick="setCollar(this,'V-Neck',{{ settings.kit_collar_vneck }})" data-collar="V-Neck"><div class="opt-img"><img src="{{ 'collar-vneck.webp' | asset_url }}" alt="V-Neck collar" width="600" height="600" loading="lazy"></div><div class="opt-body"><div class="opt-name">{{ 'kits.collar_vneck' | t }}</div><div class="opt-price">+${{ settings.kit_collar_vneck }} {{ 'kits.js.per_jersey' | t }}</div></div></div>
          <div class="opt-card" onclick="setCollar(this,'Polo',{{ settings.kit_collar_polo }})" data-collar="Polo"><div class="opt-img"><img src="{{ 'collar-polo.webp' | asset_url }}" alt="Polo collar" width="600" height="600" loading="lazy"></div><div class="opt-body"><div class="opt-name">{{ 'kits.collar_polo' | t }}</div><div class="opt-price">+${{ settings.kit_collar_polo }} {{ 'kits.js.per_jersey' | t }}</div></div></div>
          <div class="opt-card" onclick="setCollar(this,'Mandarin',{{ settings.kit_collar_mandarin }})" data-collar="Mandarin"><div class="opt-img"><img src="{{ 'collar-mandarin.webp' | asset_url }}" alt="Mandarin collar" width="600" height="600" loading="lazy"></div><div class="opt-body"><div class="opt-name">{{ 'kits.collar_mandarin' | t }}</div><div class="opt-price">+${{ settings.kit_collar_mandarin }} {{ 'kits.js.per_jersey' | t }}</div></div></div>
          <div class="opt-card" onclick="setCollar(this,'Kiwi',{{ settings.kit_collar_kiwi }})" data-collar="Kiwi"><div class="opt-img"><img src="{{ 'collar-kiwi.webp' | asset_url }}" alt="Kiwi collar" width="600" height="600" loading="lazy"></div><div class="opt-body"><div class="opt-name">{{ 'kits.collar_kiwi' | t }}</div><div class="opt-price">+${{ settings.kit_collar_kiwi }} {{ 'kits.js.per_jersey' | t }}</div></div></div>
          <div class="opt-card" onclick="setCollar(this,'Insert',0)" data-collar="Insert"><div class="opt-img"><img src="{{ 'collar-insert.webp' | asset_url }}" alt="Insert collar" width="600" height="600" loading="lazy"></div><div class="opt-body"><div class="opt-name">{{ 'kits.collar_insert' | t }}</div><div class="opt-price">{{ 'kits.included' | t }}</div></div></div>
        </div>
      </div>

      <!-- 04 QUANTITY -->
      <div style="margin-bottom:48px;" class="reveal">
        <div class="cfg-label"><span class="cfg-num">04</span> {{ 'kits.quantity' | t }}</div>
        <div class="qty-wrap">
          <div class="qty-row"><input type="range" class="qty-slider" id="qtySlider" aria-label="{{ 'kits.qty_label' | t }}" min="10" max="500" value="20" oninput="setQty(this.value)"><div class="qty-display" id="qtyDisplay" aria-hidden="true">20</div></div>
          <div class="qty-ends"><span>{{ 'kits.qty_min' | t }}</span><span>250</span><span>500+</span></div>
        </div>
      </div>

      <!-- PRICE BOX -->
      <div class="price-box reveal">
        <div class="price-lines">
          <div class="price-line"><span id="lBase">{{ 'kits.js.base_jersey' | t }} x20</span><span class="pv" id="pBase">{{ base_total | times: 100 | money }}</span></div>
          <div class="price-line" id="lCollar" style="display:none"><span>{{ 'kits.collar_upgrade' | t }}</span><span class="pv" id="pCollar"></span></div>
          <div class="price-line" id="lNames" style="display:none"><span>{{ 'kits.names_numbers' | t }}</span><span class="pv" id="pNames"></span></div>
          <div class="price-line" id="lSpon" style="display:none"><span>{{ 'kits.sponsor_print' | t }}</span><span class="pv" id="pSpon"></span></div>
          <div class="price-line" id="lEmb" style="display:none"><span>{{ 'kits.emb_crest' | t }}</span><span class="pv" id="pEmb"></span></div>
          <div class="price-line" id="lSocks" style="display:none"><span>{{ 'kits.grip_socks' | t }}</span><span class="pv" id="pSocks"></span></div>
          <div class="price-line"><span>{{ 'kits.shipping' | t }}</span><span class="pv" id="pShip">{{ start_ship | times: 100 | money }}</span></div>
          <div class="price-line total"><span>{{ 'kits.estimated_total' | t }}</span><span class="pv" id="pTotal" aria-live="polite">{{ start_total | times: 100 | money }}</span></div>
        </div>
        <div class="price-unit" id="unitNote">{%- assign unit_price = start_unit | money -%}{{ 'kits.js.unit_note' | t | replace: '[price]', unit_price }}</div>
        <a href="#project" class="aeron-btn aeron-btn-full" style="padding:15px;font-size:11px;display:block;">{{ 'kits.start_project_cta' | t }}</a>
        <div class="ship-msg ship-free" id="shipFree">{{ 'kits.free_ship_order' | t }}</div>
        <div class="ship-msg ship-paid" id="shipPaid"><span id="shipMsg"></span></div>
      </div>
      <p style="font-family:'Barlow',sans-serif;font-size:11px;color:rgba(15,26,43,.66);margin-top:12px;text-align:center;">{{ 'kits.estimate_note' | t }}</p>
    </div>
  </div>
</section>

<!-- FAQ — editable blocks in theme editor -->
{%- liquid
  assign faq_count = 0
  for block in section.blocks
    if block.type == 'faq'
      assign faq_count = faq_count | plus: 1
    endif
  endfor
-%}
{%- if faq_count > 0 -%}
<section class="section section-lt" id="faq" style="padding:90px 60px;">
  <div style="max-width:800px;margin:0 auto;" class="reveal">
    <div class="kicker">{{ 'kits.faq_kicker' | t }}</div>
    <h2 class="heading">{{ 'kits.faq_heading' | t }}</h2>
    <div class="gold-bar"></div>
    <div style="margin-top:42px;">
      {% for block in section.blocks %}
        {% if block.type == 'faq' %}
          <div class="faq-item" {{ block.shopify_attributes }}>
            <h3 class="faq-q">{{ block.settings.question }}</h3>
            <div class="faq-a">{{ block.settings.answer }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{%- endif -%}

<!-- PROJECT FORM -->
<section class="section" id="project" style="position:relative;overflow:hidden;padding:100px 60px;">
  <div style="position:absolute;font-family:'Orbitron',sans-serif;font-weight:900;font-size:200px;color:rgba(15,26,43,.02);right:-10px;top:50%;transform:translateY(-50%);pointer-events:none;letter-spacing:-10px;">AERON</div>
  <div style="max-width:1100px;margin:0 auto;position:relative;">
    <div class="reveal">
      <div class="kicker">{{ section.settings.proj_kicker | default: "Start a Project" }}</div>
      <h2 class="heading">{{ section.settings.proj_heading | default: "Ready to Take Flight?" }}</h2>
      <div class="gold-bar"></div>
      <p style="font-family:'Barlow Condensed',sans-serif;font-size:16px;color:rgba(15,26,43,.66);margin-top:18px;max-width:520px;line-height:1.7;">{{ section.settings.proj_body }}</p>
      <p style="font-family:'Barlow Condensed',sans-serif;font-size:13px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:#7A6331;margin-top:10px;">{% render 'offer-line' %}</p>
      {% if settings.whatsapp != blank %}
        <a href="https://wa.me/{{ settings.whatsapp }}" target="_blank" style="display:inline-flex;align-items:center;gap:9px;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:12px;letter-spacing:3px;text-transform:uppercase;color:rgba(15,26,43,.66);border:1px solid rgba(15,26,43,.15);padding:12px 24px;text-decoration:none;margin-top:16px;transition:all .25s;" onmouseover="this.style.borderColor='#C6A962';this.style.color='#0F1A2B'" onmouseout="this.style.borderColor='rgba(15,26,43,.15)';this.style.color='rgba(15,26,43,.5)'">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#25D366"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          {{ 'kits.whatsapp_cta' | t }}
        </a>
      {% endif %}
    </div>

    <div class="proj-layout">
      <div class="reveal">
        <div style="display:flex;gap:14px;padding:18px 0;border-top:1px solid rgba(15,26,43,.06);border-bottom:1px solid rgba(15,26,43,.06);"><div style="width:40px;height:40px;flex-shrink:0;background:#F2F2F2;border:1px solid rgba(15,26,43,.06);display:flex;align-items:center;justify-content:center;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#A88B4A" stroke-width="1.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg></div><div><div style="font-family:'Orbitron',sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#0F1A2B;margin-bottom:4px;">{{ 'kits.b1_title' | t }}</div><div style="font-family:'Barlow Condensed',sans-serif;font-size:13px;color:rgba(15,26,43,.66);line-height:1.55;">{{ 'kits.b1_text' | t }}</div></div></div>
        <div style="display:flex;gap:14px;padding:18px 0;border-bottom:1px solid rgba(15,26,43,.06);"><div style="width:40px;height:40px;flex-shrink:0;background:#F2F2F2;border:1px solid rgba(15,26,43,.06);display:flex;align-items:center;justify-content:center;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#A88B4A" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div><div><div style="font-family:'Orbitron',sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#0F1A2B;margin-bottom:4px;">{{ 'kits.b2_title' | t }}</div><div style="font-family:'Barlow Condensed',sans-serif;font-size:13px;color:rgba(15,26,43,.66);line-height:1.55;">{{ 'kits.b2_text' | t }}</div></div></div>
        <div style="display:flex;gap:14px;padding:18px 0;border-bottom:1px solid rgba(15,26,43,.06);"><div style="width:40px;height:40px;flex-shrink:0;background:#F2F2F2;border:1px solid rgba(15,26,43,.06);display:flex;align-items:center;justify-content:center;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#A88B4A" stroke-width="1.5"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 014-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 01-4 4H3"/></svg></div><div><div style="font-family:'Orbitron',sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#0F1A2B;margin-bottom:4px;">{{ 'kits.b3_title' | t }}</div><div style="font-family:'Barlow Condensed',sans-serif;font-size:13px;color:rgba(15,26,43,.66);line-height:1.55;">{{ 'kits.b3_text' | t }}</div></div></div>
        <div style="display:flex;gap:14px;padding:18px 0;border-bottom:1px solid rgba(15,26,43,.06);"><div style="width:40px;height:40px;flex-shrink:0;background:#F2F2F2;border:1px solid rgba(15,26,43,.06);display:flex;align-items:center;justify-content:center;"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#A88B4A" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg></div><div><div style="font-family:'Orbitron',sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1.5px;color:#0F1A2B;margin-bottom:4px;">{% render 'offer-line', key: 'offer.deposit_to_start' %}</div><div style="font-family:'Barlow Condensed',sans-serif;font-size:13px;color:rgba(15,26,43,.66);line-height:1.55;">{{ 'kits.b4_text' | t: deposit: settings.offer_deposit, timeline: settings.offer_timeline }}</div></div></div>
      </div>

      <div class="reveal">
        {%- form 'contact', id: 'projForm', class: 'proj-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="proj-success" style="display:block;margin-top:0;" role="status">
              <div class="proj-success-ttl">{{ 'kits.success_title' | t }}</div>
              <div class="proj-success-msg">{{ section.settings.proj_success }}</div>
              {%- if settings.whatsapp != blank -%}<a href="https://wa.me/{{ settings.whatsapp }}" target="_blank" rel="noopener" class="aeron-btn" style="padding:16px 48px;font-size:11px;">{{ 'kits.whatsapp' | t }}</a>{%- endif -%}
            </div>
          {%- else -%}
            {%- if form.errors -%}
              <div class="form-error" role="alert">{{ 'kits.form_error' | t }}{{ form.errors | default_errors }}</div>
            {%- endif -%}
            <input type="hidden" name="contact[Configurator Summary]" id="supplierSummary">
            <div class="f-row">
              <div class="f-group"><label class="f-label" for="pf-team">{{ 'kits.f_team' | t }}</label><input class="f-input" id="pf-team" type="text" name="contact[Team Name]" placeholder="{{ 'kits.ph_team' | t }}" autocomplete="organization" required></div>
              <div class="f-group"><label class="f-label" for="pf-name">{{ 'kits.f_name' | t }}</label><input class="f-input" id="pf-name" type="text" name="contact[Name]" placeholder="{{ 'kits.ph_name' | t }}" autocomplete="name" required></div>
            </div>
            <div class="f-row">
              <div class="f-group"><label class="f-label" for="pf-email">{{ 'kits.f_email' | t }}</label><input class="f-input" id="pf-email" type="email" name="contact[email]" placeholder="{{ 'kits.ph_email' | t }}" autocomplete="email" value="{{ form.email }}" required></div>
              <div class="f-group"><label class="f-label" for="pf-phone">{{ 'kits.f_phone' | t }}</label><input class="f-input" id="pf-phone" type="tel" name="contact[Phone]" placeholder="+1 514 000 0000" autocomplete="tel"></div>
            </div>
            <div class="f-row">
              <div class="f-group"><label class="f-label" for="pf-kit">{{ 'kits.kit_type' | t }}</label><select class="f-select" id="pf-kit" name="contact[Kit Type]"><option value="">{{ 'kits.f_select' | t }}</option><option>{{ 'kits.f_kit_jersey' | t }}</option><option>{{ 'kits.f_kit_shorts' | t }}</option></select></div>
              <div class="f-group"><label class="f-label" for="pf-qty">{{ 'kits.quantity' | t }}</label><select class="f-select" id="pf-qty" name="contact[Quantity]"><option value="">{{ 'kits.f_select' | t }}</option><option>10 &ndash; 49</option><option>50 &ndash; 99</option><option>100 &ndash; 199</option><option>200 &ndash; 499</option><option>500+</option></select></div>
            </div>
            <div class="f-group"><label class="f-label" for="pf-notes">{{ 'kits.f_notes' | t }}</label><textarea class="f-textarea" id="pf-notes" name="contact[Notes]" placeholder="{{ 'kits.ph_notes' | t }}"></textarea></div>
            <div class="file-note">
              {%- capture files_link -%}<a href="mailto:{{ settings.email | default: shop.email }}">{{ settings.email | default: shop.email }}</a>{%- endcapture -%}{{ 'kits.files_note_html' | t: link: files_link }}
            </div>
            <div class="dep-card">
              <div class="dep-row">
                <div><div class="dep-ttl">{{ 'kits.how_it_works' | t }}</div><div class="dep-sub">{{ 'kits.quote_first' | t }}</div></div>
                <div class="dep-amt">{{ settings.offer_deposit }}<small> {{ 'offer.deposit_word' | t }}</small></div>
              </div>
              <div class="dep-feats">
                <div class="dep-feat">{{ 'kits.d1' | t }}</div>
                <div class="dep-feat">{{ 'kits.d2' | t }}</div>
                <div class="dep-feat">{{ 'kits.d3' | t }}</div>
                <div class="dep-feat">{% render 'offer-line', key: 'offer.deposit_to_start' %}</div>
                <div class="dep-feat">{{ settings.offer_timeline }}</div>
                <div class="dep-feat">{{ 'kits.d4' | t }}</div>
              </div>
              <button type="submit" class="aeron-btn aeron-btn-full" id="payBtn" style="padding:17px;font-size:11px;display:block;border-radius:0;">{{ 'kits.submit' | t }}</button>
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kits Page",
  "settings": [
    { "type": "header",       "content": "APEX Header" },
    { "type": "text",         "id": "tier_label",   "label": "Tier label",        "default": "Tier 01 — Airborne Series" },
    { "type": "text",         "id": "kit_tagline",  "label": "Kit tagline",        "default": "One kit. Everything premium." },
    { "type": "text",         "id": "price_from",   "label": "Price from text",    "default": "from" },
    { "type": "text",         "id": "price_unit",   "label": "Price unit", "info": "The price itself comes from Theme settings → Kit pricing.",         "default": "CAD / jersey" },
    { "type": "image_picker", "id": "kit_image",    "label": "APEX kit photo" },
    { "type": "header",       "content": "Add-On Photos" },
    { "type": "image_picker", "id": "img_jersey",   "label": "Jersey Only photo" },
    { "type": "image_picker", "id": "img_shorts",   "label": "Jersey + Shorts photo" },
    { "type": "image_picker", "id": "img_names",    "label": "Player Names photo" },
    { "type": "image_picker", "id": "img_sponsor",  "label": "Sponsor Logo photo" },
    { "type": "image_picker", "id": "img_emb",      "label": "Embroidered Crest photo" },
    { "type": "image_picker", "id": "img_socks",    "label": "Grip Socks photo" },
    { "type": "header",       "content": "Project Form" },
    { "type": "richtext", "id": "proj_success", "label": "Success message", "default": "<p>Thanks — your project request is in. We'll reply within 24 hours with your quote and next steps.</p>" },
    { "type": "header",       "content": "Build Section" },
    { "type": "text",         "id": "build_kicker",  "label": "Build kicker",   "default": "Configure" },
    { "type": "text",         "id": "build_heading", "label": "Build heading",  "default": "Build Your Kit." },
    { "type": "text",         "id": "incl_label",    "label": "Included banner label", "default": "Always included in every APEX kit" },
    { "type": "textarea",     "id": "incl_items",    "label": "Included items (separate with ·)", "default": "Full sublimation · AERON embroidered logo · TPU raised club crest · Sublimated sponsor logos · Round collar" },
    { "type": "header",       "content": "Project Section" },
    { "type": "text",         "id": "proj_kicker",   "label": "Project kicker",     "default": "Start a Project" },
    { "type": "text",         "id": "proj_heading",  "label": "Project heading",    "default": "Ready to Take Flight?" },
    { "type": "textarea",     "id": "proj_body",     "label": "Project body text",  "default": "Tell us about your team and we'll reply within 24 hours with a quote and next steps." }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ Item",
      "settings": [
        { "type": "text",     "id": "question", "label": "Question", "default": "How long does production take?" },
        { "type": "textarea", "id": "answer",   "label": "Answer",   "default": "7 to 15 business days after you approve your mockup." }
      ]
    }
  ],
  "presets": [{ "name": "Kits Page", "blocks": [
    { "type": "faq", "settings": {"question": "How long does it take?", "answer": "4–5 weeks from your deposit, design included. Need your kits by a specific date? Tell us in the notes and we'll confirm before you commit."} },
    { "type": "faq", "settings": {"question": "What file format do I need for my logo?", "answer": "Vector files (AI, SVG, PDF or EPS) are ideal. A high-resolution PNG with a transparent background also works. If you only have a JPEG, send it anyway and we'll work with what you have."} },
    { "type": "faq", "settings": {"question": "How does payment work?", "answer": "We send you a quote first. Once you approve it, a 50% deposit starts design and production. Your quote confirms when the balance is due."} },
    { "type": "faq", "settings": {"question": "Will I see the design before production?", "answer": "Yes. You get a full digital mockup of your APEX kit and up to 3 revision rounds before anything is printed."} },
    { "type": "faq", "settings": {"question": "What is the minimum order?", "answer": "10 jerseys. No maximum."} },
    { "type": "faq", "settings": {"question": "Do you ship across Canada?", "answer": "Yes. Orders of 100+ jerseys ship free anywhere in Canada."} }
  ]}]
}
{% endschema %}