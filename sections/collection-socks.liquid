<section style="padding:100px 60px 60px;background:#0F1A2B;position:relative;overflow:hidden;">
  <div style="position:absolute;font-family:'Bebas Neue',sans-serif;font-size:260px;color:rgba(255,255,255,.018);right:-20px;top:50%;transform:translateY(-50%);pointer-events:none;letter-spacing:-8px;line-height:1;">SOCKS</div>
  <div style="position:relative;z-index:2;max-width:900px;">
    <div class="kicker-w">Airborne Series</div>
    <div style="font-family:'Bebas Neue',sans-serif;font-size:clamp(52px,9vw,110px);letter-spacing:4px;color:#fff;line-height:.86;margin-bottom:18px;">Launch Pads&#8482;</div>
    <div style="font-family:'Barlow Condensed',sans-serif;font-size:16px;color:rgba(255,255,255,.66);line-height:1.65;max-width:520px;margin-bottom:30px;">Anti-slip silicone grip pads. Arch compression band. Seamless toe. Wear inside your regular football sock. Sizes US&nbsp;9.5&ndash;12.</div>
  </div>
</section>

<section class="section" style="padding:80px 60px;">
  <div style="max-width:1100px;margin:0 auto;">
    {% if collection.products.size > 0 %}
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:3px;margin-bottom:3px;" class="prod-grid-main">
        {% for product in collection.products %}
          <a href="{{ product.url }}" style="text-decoration:none;" class="prod-card">
            <div class="prod-img">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | img_url: '600x600', crop: 'center' }}" alt="{{ product.featured_image.alt | escape }}" width="600" height="600" loading="lazy">
              {% else %}
                <div style="font-family:'Bebas Neue',sans-serif;font-size:48px;letter-spacing:4px;color:rgba(15,26,43,.1);">LAUNCH PADS</div>
              {% endif %}
            </div>
            <div class="prod-info">
              <div class="prod-cat">{{ product.type | default: 'Grip Socks — Airborne Series' }}</div>
              <div class="prod-name">{{ product.title }}</div>
              <div class="prod-price">{{ product.price | money }}</div>
              <div class="aeron-btn" style="display:inline-block;margin-top:14px;padding:10px 22px;font-size:10px;">Select Options</div>
            </div>
          </a>
        {% endfor %}
      </div>
    {% else %}
      <div style="text-align:center;padding:80px 20px;">
        <div style="font-family:'Orbitron',sans-serif;font-size:14px;color:rgba(15,26,43,.66);text-transform:uppercase;letter-spacing:3px;margin-bottom:16px;">Products coming soon</div>
        <p style="font-family:'Barlow Condensed',sans-serif;font-size:15px;color:rgba(15,26,43,.66);">Add your grip sock products in Shopify Admin &rarr; Products, then assign them to this Grip Socks collection.</p>
      </div>
    {% endif %}

    <!-- Coming Soon -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:3px;margin-top:3px;" class="prod-grid-cs">
      <div style="border:1px solid rgba(15,26,43,.06);background:#F2F2F2;opacity:.6;">
        <div style="aspect-ratio:1;background:rgba(15,26,43,.04);display:flex;align-items:center;justify-content:center;border-bottom:1px solid rgba(15,26,43,.06);"><div style="font-family:'Bebas Neue',sans-serif;font-size:52px;letter-spacing:4px;color:rgba(15,26,43,.08);">SOON</div></div>
        <div style="padding:18px 20px;"><div class="prod-cat">Accessories</div><div class="prod-name">Shin Guards</div><div style="font-family:'Barlow Condensed',sans-serif;font-size:13px;color:rgba(15,26,43,.66);line-height:1.55;margin:6px 0 14px;">Lightweight moulded protection. Slim profile, maximum coverage.</div><div style="font-family:'Barlow Condensed',sans-serif;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:rgba(15,26,43,.66);border:1px solid rgba(15,26,43,.12);padding:10px 16px;display:inline-block;">Coming Soon</div></div>
      </div>
      <div style="border:1px solid rgba(15,26,43,.06);background:#F2F2F2;opacity:.6;">
        <div style="aspect-ratio:1;background:rgba(15,26,43,.04);display:flex;align-items:center;justify-content:center;border-bottom:1px solid rgba(15,26,43,.06);"><div style="font-family:'Bebas Neue',sans-serif;font-size:52px;letter-spacing:4px;color:rgba(15,26,43,.08);">SOON</div></div>
        <div style="padding:18px 20px;"><div class="prod-cat">Accessories</div><div class="prod-name">Kit Bag</div><div style="font-family:'Barlow Condensed',sans-serif;font-size:13px;color:rgba(15,26,43,.66);line-height:1.55;margin:6px 0 14px;">Waterproof team bag. Custom sublimated with your club badge.</div><div style="font-family:'Barlow Condensed',sans-serif;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:rgba(15,26,43,.66);border:1px solid rgba(15,26,43,.12);padding:10px 16px;display:inline-block;">Coming Soon</div></div>
      </div>
      <div style="border:1px solid rgba(15,26,43,.06);background:#F2F2F2;opacity:.6;">
        <div style="aspect-ratio:1;background:rgba(15,26,43,.04);display:flex;align-items:center;justify-content:center;border-bottom:1px solid rgba(15,26,43,.06);"><div style="font-family:'Bebas Neue',sans-serif;font-size:52px;letter-spacing:4px;color:rgba(15,26,43,.08);">SOON</div></div>
        <div style="padding:18px 20px;"><div class="prod-cat">Accessories</div><div class="prod-name">Training Bibs</div><div style="font-family:'Barlow Condensed',sans-serif;font-size:13px;color:rgba(15,26,43,.66);line-height:1.55;margin:6px 0 14px;">Numbered mesh bibs. Breathable and lightweight.</div><div style="font-family:'Barlow Condensed',sans-serif;font-size:10px;font-weight:700;letter-spacing:3px;text-transform:uppercase;color:rgba(15,26,43,.66);border:1px solid rgba(15,26,43,.12);padding:10px 16px;display:inline-block;">Coming Soon</div></div>
      </div>
    </div>
    <style>@media(max-width:900px){.prod-grid-main,.prod-grid-cs{grid-template-columns:1fr 1fr!important;}}</style>
  </div>
</section>
{% schema %}
{"name":"Grip Socks Collection","presets":[{"name":"Grip Socks Collection"}]}
{% endschema %}
