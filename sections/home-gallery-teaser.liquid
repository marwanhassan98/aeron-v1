<style>
.gal-tease-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:3px;}
.gal-tease-grid .gallery-cell:first-child{grid-row:span 2;}
@media(max-width:900px){.gal-tease-grid{grid-template-columns:1fr 1fr!important;}.gal-tease-grid .gallery-cell:first-child{grid-row:auto!important;}}
</style>
{%- liquid
  assign shown = 0
  for block in section.blocks
    if block.settings.image != blank or request.design_mode
      assign shown = shown | plus: 1
    endif
  endfor
-%}
{%- if shown > 0 -%}
<section class="section section-dk" style="padding:100px 60px;">
  <div style="max-width:1200px;margin:0 auto;">
    <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:36px;flex-wrap:wrap;gap:16px;" class="reveal">
      <div>
        <div class="kicker-w">{{ section.settings.kicker | default: 'Kitted Teams' }}</div>
        <h2 class="heading-w">{{ section.settings.heading | default: 'The Squads.' }}</h2>
      </div>
      <a href="{{ section.settings.link_url | default: '/pages/gallery' }}" class="aeron-btn-outline-w" style="padding:12px 28px;white-space:nowrap;">{{ section.settings.link_label | default: 'See All Teams →' }}</a>
    </div>
    <div class="gal-tease-grid">
      {% for block in section.blocks %}
        {%- if block.settings.image == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
        <div class="gallery-cell reveal" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 1200 | image_tag: class: 'gallery-img', widths: '400, 600, 800, 1200', sizes: '(max-width: 900px) 50vw, 33vw', loading: 'lazy', alt: block.settings.name, style: 'min-height:250px;' }}
          {% else %}
            <div class="gallery-ph" style="min-height:250px;">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <div class="gallery-ph-lbl">{{ block.settings.name | default: 'Team Name' }}</div>
            </div>
          {% endif %}
          <div class="gallery-lbl">
            <div class="gallery-lbl-name">{{ block.settings.name }}</div>
            <div class="gallery-lbl-sub">{{ block.settings.location | default: 'Montréal, QC' }}</div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{%- endif -%}
{% schema %}
{
  "name": "Gallery Teaser",
  "settings": [
    { "type": "text", "id": "kicker",     "label": "Kicker",      "default": "Kitted Teams" },
    { "type": "text", "id": "heading",    "label": "Heading",      "default": "The Squads." },
    { "type": "text", "id": "link_label", "label": "Link text",    "default": "See All Teams →" },
    { "type": "url",  "id": "link_url",   "label": "Link URL" }
  ],
  "blocks": [{ "type": "team", "name": "Team", "settings": [
    { "type": "image_picker", "id": "image",    "label": "Photo" },
    { "type": "text",         "id": "name",     "label": "Team name" },
    { "type": "text",         "id": "location", "label": "Location", "default": "Montréal, QC" }
  ]}],
  "presets": [{ "name": "Gallery Teaser", "blocks": [
    { "type": "team" }, { "type": "team" }, { "type": "team" }
  ]}]
}
{% endschema %}
