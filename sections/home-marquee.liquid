{%- comment -%}Scrolling strip. Items render twice so the -50% loop is seamless; the copy is hidden from screen readers.{%- endcomment -%}
{%- capture mq_items -%}
  {%- for block in section.blocks -%}
    <span class="mq-item{% if block.settings.gold %} mq-gold{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
  {%- else -%}
    {%- assign fallback = 'marquee.fallback' | t | split: '|' -%}
    {%- for item in fallback -%}<span class="mq-item">{{ item }}</span><span class="mq-item mq-gold">&mdash;</span>{%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
<div class="mq-strip">
  <button type="button" class="loop-pause" aria-pressed="false" aria-label="{{ 'general.pause_animation' | t }}" data-loop-pause>&#10074;&#10074;</button>
  <div class="mq-track">
    <div class="mq-set">{{ mq_items }}</div>
    <div class="mq-set" aria-hidden="true">{{ mq_items }}</div>
  </div>
</div>
{% schema %}
{
  "name": "Marquee Strip",
  "blocks": [{ "type": "item", "name": "Marquee Item", "settings": [
    { "type": "text",     "id": "text", "label": "Text", "default": "Custom Football Kits" },
    { "type": "checkbox", "id": "gold", "label": "Gold color", "default": false }
  ]}],
  "presets": [{ "name": "Marquee Strip" }]
}
{% endschema %}
