{% comment %}AERON — All collections{% endcomment %}
<section class="section">
  <div style="max-width:1100px;margin:0 auto;">
    <div class="kicker">{{ section.settings.kicker }}</div>
    <h1 class="heading">{{ section.settings.heading }}</h1>
    <div class="gold-bar"></div>
    <div class="prod-grid" style="margin-top:40px;">
      {%- for collection in collections -%}
        {%- if collection.all_products_count > 0 -%}
          <a href="{{ collection.url }}" class="prod-card">
            <div class="prod-img">
              {%- assign c_img = collection.image | default: collection.products.first.featured_image -%}
              {%- if c_img -%}
                {{ c_img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 400, 600, 800', sizes: '(max-width: 600px) 100vw, (max-width: 900px) 50vw, 360px', alt: collection.title }}
              {%- endif -%}
            </div>
            <div class="prod-info">
              <div class="prod-cat">{{ 'collections.product_count' | t: count: collection.all_products_count }}</div>
              <h2 class="prod-name">{{ collection.title }}</h2>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "kicker",  "label": "Kicker",  "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All Collections." }
  ]
}
{% endschema %}
