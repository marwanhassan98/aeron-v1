{% comment %}AERON — Storefront password page{% endcomment %}
<h1 class="logo">{{ shop.name | upcase }}</h1>
<div class="sub">{{ section.settings.tagline }}</div>
{%- if shop.password_message != blank -%}<p class="msg">{{ shop.password_message }}</p>{%- endif -%}

{%- if section.settings.show_newsletter -%}
  {%- form 'customer', id: 'PasswordNewsletter' -%}
    <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
    {%- if form.posted_successfully? -%}
      <p class="pw-ok" role="status">{{ 'password.newsletter_success' | t }}</p>
    {%- else -%}
      <div class="pw-form">
        <label class="visually-hidden" for="PwEmail">{{ 'password.email' | t }}</label>
        <input class="pw-input" id="PwEmail" type="email" name="contact[email]" placeholder="{{ 'password.email' | t }}" autocomplete="email" required>
        <button type="submit" class="pw-btn">{{ 'password.notify' | t }}</button>
      </div>
      {%- if form.errors -%}<div class="pw-err" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    {%- endif -%}
  {%- endform -%}
  <div class="pw-sep"></div>
{%- endif -%}

{%- form 'storefront_password' -%}
  <div class="pw-form">
    <label class="visually-hidden" for="PwPassword">{{ 'password.password' | t }}</label>
    <input class="pw-input" id="PwPassword" type="password" name="password" placeholder="{{ 'password.password' | t }}" autocomplete="current-password">
    <button type="submit" class="pw-btn">{{ 'password.enter' | t }}</button>
  </div>
  {%- if form.errors -%}<p class="pw-err" role="alert">{{ 'password.wrong' | t }}</p>{%- endif -%}
{%- endform -%}

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text",     "id": "tagline",         "label": "Tagline", "default": "Rise Above Everything — Coming Soon" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show email signup", "default": true }
  ]
}
{% endschema %}
