<style>
#hero{height:100vh;min-height:680px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;background:#0F1A2B;margin-top:-70px;}
#hero-canvas{position:absolute;inset:0;pointer-events:none;}
#hero-video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.35;pointer-events:none;}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(to bottom,rgba(15,26,43,.5) 0%,rgba(15,26,43,.3) 50%,rgba(15,26,43,.7) 100%);pointer-events:none;}
.hero-grid-svg{position:absolute;inset:0;pointer-events:none;opacity:.038;}
.hero-content{position:relative;z-index:2;text-align:center;padding:0 20px;}
@keyframes hSlam{to{opacity:1;transform:translateY(0) scaleY(1)}}
@keyframes hUp{0%{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.hero-eye{font-family:'Barlow Condensed',sans-serif;font-size:11px;font-weight:600;letter-spacing:8px;text-transform:uppercase;color:#C6A962;opacity:0;animation:hUp .7s forwards .65s;margin-bottom:22px;}
.hero-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(80px,15vw,210px);line-height:.82;color:#fff;opacity:0;transform:translateY(-50px) scaleY(1.06);animation:hSlam .55s cubic-bezier(.22,1,.36,1) forwards .1s;}
.hero-gold{background:linear-gradient(135deg,#A88B4A,#E8C97A,#C6A962);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;}
.hero-div{display:flex;align-items:center;justify-content:center;gap:18px;margin:18px 0 14px;opacity:0;animation:hUp .6s forwards .8s;}
.hero-div-line{height:1px;width:64px;background:rgba(198,169,98,.25);}
.hero-sub{font-family:'Barlow Condensed',sans-serif;font-size:clamp(11px,2vw,18px);letter-spacing:7px;text-transform:uppercase;color:rgba(255,255,255,.66);opacity:0;animation:hUp .7s forwards .95s;margin-bottom:48px;}
.hero-sub strong{color:rgba(255,255,255,.66);}
.hero-ctas{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;opacity:0;animation:hUp .7s forwards 1.1s;}
.hero-scroll{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:8px;opacity:0;animation:hUp .6s forwards 1.5s;}
.hero-scroll-lbl{font-family:'Barlow Condensed',sans-serif;font-size:9px;letter-spacing:4px;text-transform:uppercase;color:rgba(255,255,255,.66);}
.scroll-line{width:1px;height:38px;background:linear-gradient(to bottom,#C6A962,transparent);animation:sbar 2s ease-in-out infinite 2s;}
@keyframes sbar{50%{opacity:.2;transform:scaleY(1.4)}}
</style>

<section id="hero">
  {% if section.settings.video_url != blank %}
    <video id="hero-video" autoplay muted loop playsinline>
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>
    <div class="hero-overlay"></div>
  {% elsif section.settings.bg_image != blank %}
    <div style="position:absolute;inset:0;background-image:url('{{ section.settings.bg_image | img_url: '1800x' }}');background-size:cover;background-position:center;opacity:.4;"></div>
    <div class="hero-overlay"></div>
  {% else %}
    <canvas id="hero-canvas"></canvas>
    <div class="hero-grid-svg">
      <svg viewBox="0 0 1400 900" fill="none" preserveAspectRatio="xMidYMid slice" width="100%" height="100%">
        <line x1="700" y1="0" x2="700" y2="900" stroke="white" stroke-width=".5"/>
        <line x1="0" y1="450" x2="1400" y2="450" stroke="white" stroke-width=".5"/>
        <circle cx="700" cy="450" r="180" stroke="white" stroke-width=".4" fill="none"/>
        <circle cx="700" cy="450" r="340" stroke="white" stroke-width=".3" fill="none"/>
        <rect x="80" y="60" width="1240" height="780" stroke="white" stroke-width=".4" fill="none"/>
      </svg>
    </div>
  {% endif %}

  <div class="hero-content">
    <div class="hero-eye">{{ section.settings.eyebrow | default: 'Airborne Series — Custom Football Kits — Montréal' }}</div>
    <h1 class="hero-title">
      {{ section.settings.title_line1 | default: 'Rise' }}<br>
      <span class="hero-gold">{{ section.settings.title_line2 | default: 'Above' }}</span><br>
      {{ section.settings.title_line3 | default: 'Everything.' }}
    </h1>
    <div class="hero-div">
      <div class="hero-div-line"></div>
      <svg width="11" height="11" viewBox="0 0 14 14" fill="none"><path d="M7 1L8.2 5.2H12.5L9.1 7.6L10.4 12L7 9.4L3.6 12L4.9 7.6L1.5 5.2H5.8L7 1Z" fill="#C6A962" opacity=".55"/></svg>
      <div class="hero-div-line"></div>
    </div>
    <div class="hero-sub"><strong>{{ section.settings.sub_bold | default: 'Premium Custom Kits' }}</strong> {{ section.settings.sub_text | default: 'built for the pitch' }}</div>
    <div class="hero-ctas">
      <a href="{{ section.settings.btn1_url | default: '/pages/kits' }}" class="aeron-btn" style="padding:16px 44px;font-size:11px;">{{ section.settings.btn1_label | default: 'The APEX Kit' }} &rarr;</a>
      <a href="{{ section.settings.btn2_url | default: '/pages/gallery' }}" class="aeron-btn-outline-w" style="padding:16px 44px;">{{ section.settings.btn2_label | default: 'Our Teams' }}</a>
    </div>
  </div>
  <div class="hero-scroll"><span class="hero-scroll-lbl">Scroll</span><div class="scroll-line"></div></div>
</section>

<script>
(function(){
  var canvas=document.getElementById('hero-canvas');
  if(!canvas)return;
  var ctx=canvas.getContext('2d'),W,H,pts=[],dpr=Math.min(window.devicePixelRatio||1,2);
  var still=window.matchMedia('(prefers-reduced-motion:reduce)').matches||(navigator.connection&&navigator.connection.saveData);
  var running=false,visible=true,last=0,raf=0;
  function resize(){
    W=canvas.clientWidth;H=canvas.clientHeight;
    canvas.width=W*dpr;canvas.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);
    pts=[];
    var n=W<700?28:50;
    for(var i=0;i<n;i++)pts.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.28,vy:(Math.random()-.5)*.28,r:Math.random()*1.3+.4,a:Math.random()});
    draw(true);
  }
  function draw(once){
    ctx.clearRect(0,0,W,H);
    pts.forEach(function(p){
      if(!once){p.x+=p.vx*2;p.y+=p.vy*2;}
      if(p.x<0)p.x=W;if(p.x>W)p.x=0;if(p.y<0)p.y=H;if(p.y>H)p.y=0;
      ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
      ctx.fillStyle='rgba(198,169,98,'+p.a*.15+')';ctx.fill();
    });
    for(var i=0;i<pts.length;i++)for(var j=i+1;j<pts.length;j++){
      var p=pts[i],q=pts[j],dx=p.x-q.x,dy=p.y-q.y,d=dx*dx+dy*dy;
      if(d<16900){
        d=Math.sqrt(d);
        ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(q.x,q.y);
        ctx.strokeStyle='rgba(198,169,98,'+(.05*(1-d/130))+')';
        ctx.lineWidth=.5;ctx.stroke();
      }
    }
  }
  function tick(t){
    if(!running)return;
    if(t-last>=33){last=t;draw(false);}
    raf=requestAnimationFrame(tick);
  }
  function setRunning(){
    var should=!still&&visible&&!document.hidden;
    if(should&&!running){running=true;raf=requestAnimationFrame(tick);}
    else if(!should&&running){running=false;cancelAnimationFrame(raf);}
  }
  new IntersectionObserver(function(e){visible=e[0].isIntersecting;setRunning();}).observe(canvas);
  document.addEventListener('visibilitychange',setRunning);
  var rt;window.addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(resize,150);});
  resize();setRunning();
})();
</script>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "header",    "content": "Background — pick one, leave others blank" },
    { "type": "text",      "id": "video_url",   "label": "Video URL (MP4 hosted on Shopify Files)", "info": "Upload your video in Shopify Admin → Content → Files, then paste the URL here" },
    { "type": "image_picker", "id": "bg_image", "label": "Background photo (if no video)" },
    { "type": "header",    "content": "Text" },
    { "type": "text",      "id": "eyebrow",     "label": "Eyebrow text",       "default": "Airborne Series — Custom Football Kits — Montréal" },
    { "type": "text",      "id": "title_line1", "label": "Title line 1",        "default": "Rise" },
    { "type": "text",      "id": "title_line2", "label": "Title line 2 (gold)", "default": "Above" },
    { "type": "text",      "id": "title_line3", "label": "Title line 3",        "default": "Everything." },
    { "type": "text",      "id": "sub_bold",    "label": "Subtitle — bold part","default": "Premium Custom Kits" },
    { "type": "text",      "id": "sub_text",    "label": "Subtitle — rest",     "default": "built for the pitch" },
    { "type": "header",    "content": "Buttons" },
    { "type": "text",      "id": "btn1_label",  "label": "Button 1 text",  "default": "The APEX Kit" },
    { "type": "url",       "id": "btn1_url",    "label": "Button 1 URL" },
    { "type": "text",      "id": "btn2_label",  "label": "Button 2 text",  "default": "Our Teams" },
    { "type": "url",       "id": "btn2_url",    "label": "Button 2 URL" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
