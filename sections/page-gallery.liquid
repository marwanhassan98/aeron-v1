<section style="padding:100px 60px 60px;background:#0F1A2B;position:relative;overflow:hidden;">
  <div style="position:absolute;font-family:'Bebas Neue',sans-serif;font-size:260px;color:rgba(255,255,255,.018);right:-20px;top:50%;transform:translateY(-50%);pointer-events:none;letter-spacing:-8px;line-height:1;" aria-hidden="true">{{ section.settings.watermark }}</div>
  <div style="position:relative;z-index:2;max-width:900px;">
    <div class="kicker-w">{{ section.settings.kicker }}</div>
    <h1 style="font-family:'Bebas Neue',sans-serif;font-size:clamp(52px,9vw,110px);letter-spacing:4px;color:#fff;line-height:.86;margin-bottom:18px;">{{ section.settings.heading | newline_to_br }}</h1>
    <div style="font-family:'Barlow Condensed',sans-serif;font-size:16px;color:rgba(255,255,255,.66);line-height:1.65;max-width:520px;margin-bottom:30px;">{{ section.settings.text }}</div>
    {%- if section.settings.btn_label != blank -%}<a href="{{ section.settings.btn_url | default: '/pages/kits#project' }}" class="aeron-btn" style="padding:14px 40px;font-size:11px;">{{ section.settings.btn_label }}</a>{%- endif -%}
  </div>
</section>

{%- liquid
  assign shown = 0
  for block in section.blocks
    if block.settings.image != blank or request.design_mode
      assign shown = shown | plus: 1
    endif
  endfor
-%}
{%- if shown > 0 -%}
<section style="padding:0 60px 100px;background:#0F1A2B;">
  <div class="gallery-grid">
    {% for block in section.blocks %}
      {%- if block.settings.image == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
      <div class="gallery-cell{% if block.settings.tall %} tall{% endif %}{% if block.settings.wide %} wide{% endif %}" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 1600 | image_tag: class: 'gallery-img', widths: '400, 600, 800, 1100, 1600', sizes: '(max-width: 900px) 50vw, 33vw', loading: 'lazy', alt: block.settings.team_name }}
        {% else %}
          <div class="gallery-ph" style="min-height:240px;">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            <div class="gallery-ph-lbl">{{ block.settings.team_name | default: 'Team Name' }}</div>
          </div>
        {% endif %}
        <div class="gallery-lbl">
          <div class="gallery-lbl-name">{{ block.settings.team_name }}</div>
          <div class="gallery-lbl-sub">{{ block.settings.location | default: 'Montréal, QC' }}</div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>
{%- endif -%}

<section class="section section-mid" style="text-align:center;">
  <div class="reveal">
    <div class="kicker-w">{{ section.settings.cta_kicker }}</div>
    <h2 style="font-family:'Bebas Neue',sans-serif;font-size:clamp(40px,7vw,80px);letter-spacing:4px;color:#fff;line-height:.9;margin-bottom:20px;">{{ section.settings.cta_heading | newline_to_br }}</h2>
    <div style="font-family:'Barlow Condensed',sans-serif;font-size:16px;color:rgba(255,255,255,.66);margin-bottom:36px;">{% render 'offer-line', key: 'offer.cta_line' %}</div>
    <a href="{{ section.settings.cta_url | default: '/pages/kits#project' }}" class="aeron-btn" style="padding:17px 56px;font-size:12px;">{{ section.settings.cta_label }}</a>
  </div>
</section>

<style>@media(max-width:900px){section[style*="padding:0 60px"]{padding:0 22px 80px!important;}}</style>

{% schema %}
{
  "name": "Gallery Page",
  "settings": [
    { "type": "header",   "content": "Hero" },
    { "type": "text",     "id": "kicker",     "label": "Kicker",  "default": "Our Teams" },
    { "type": "textarea", "id": "heading",    "label": "Heading", "default": "The\nSquads." },
    { "type": "textarea", "id": "text",       "label": "Text",    "default": "Montréal clubs, one kit studio. Every team that wears AERON is part of the story." },
    { "type": "text",     "id": "watermark",  "label": "Background word", "default": "SQUADS" },
    { "type": "text",     "id": "btn_label",  "label": "Button text", "default": "Join Them →" },
    { "type": "url",      "id": "btn_url",    "label": "Button link" },
    { "type": "header",   "content": "Bottom call to action" },
    { "type": "text",     "id": "cta_kicker", "label": "Kicker",  "default": "Your Team" },
    { "type": "textarea", "id": "cta_heading","label": "Heading", "default": "Your Squad\nis Next." },
    { "type": "text",     "id": "cta_label",  "label": "Button text", "default": "Start a Project →" },
    { "type": "url",      "id": "cta_url",    "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "team",
      "name": "Team",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Team photo" },
        { "type": "text", "id": "team_name", "label": "Team name" },
        { "type": "text", "id": "location", "label": "Location", "default": "Montréal, QC" },
        { "type": "checkbox", "id": "tall", "label": "Tall (2 rows tall)", "default": false },
        { "type": "checkbox", "id": "wide", "label": "Wide (2 cols wide)", "default": false }
      ]
    }
  ],
  "presets": [{
    "name": "Gallery Page",
    "blocks": [
      { "type": "team" },
      { "type": "team" },
      { "type": "team" },
      { "type": "team" }
    ]
  }]
}
{% endschema %}
