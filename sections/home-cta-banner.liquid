<section style="background:{{ section.settings.bg_color | default: '#080e18' }};position:relative;overflow:hidden;">
  {% if section.settings.bg_image != blank %}
    <div style="position:absolute;inset:0;background-image:url('{{ section.settings.bg_image | img_url: '1600x' }}');background-size:cover;background-position:center;opacity:.2;pointer-events:none;"></div>
  {% endif %}
  <div class="cta-banner-inner" style="position:relative;z-index:1;">
    <div class="reveal">
      <div class="kicker-w">{{ section.settings.kicker | default: 'Start Today' }}</div>
      <h2 style="font-family:'Bebas Neue',sans-serif;font-size:clamp(44px,8vw,96px);letter-spacing:4px;color:#fff;line-height:.88;margin-bottom:20px;">{{ section.settings.heading | default: 'Your Squad is Next.' }}</h2>
      <div style="font-family:'Barlow Condensed',sans-serif;font-size:16px;color:rgba(255,255,255,.66);margin-bottom:40px;letter-spacing:1px;">{% if section.settings.subheading != blank %}{{ section.settings.subheading }}{% else %}{% render 'offer-line', key: 'offer.cta_line' %}{% endif %}</div>
      <a href="{{ section.settings.btn_url | default: '/pages/kits#project' }}" class="aeron-btn" style="padding:18px 60px;font-size:12px;">{{ section.settings.btn_label | default: 'Start a Project →' }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "CTA Banner",
  "settings": [
    { "type": "image_picker", "id": "bg_image",   "label": "Background photo (optional)" },
    { "type": "text",         "id": "kicker",     "label": "Kicker text",    "default": "Start Today" },
    { "type": "text",         "id": "heading",    "label": "Heading",        "default": "Your Squad is Next." },
    { "type": "textarea",     "id": "subheading", "label": "Subheading", "info": "Leave blank to show the offer from Theme settings → Offer." },
    { "type": "text",         "id": "btn_label",  "label": "Button text",    "default": "Start a Project →" },
    { "type": "url",          "id": "btn_url",    "label": "Button URL" }
  ],
  "presets": [{ "name": "CTA Banner" }]
}
{% endschema %}