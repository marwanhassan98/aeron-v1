<footer class="site-footer">
  <a href="{{ routes.root_url }}" style="text-decoration:none;">
    {% if settings.logo_light != blank %}
      <img src="{{ settings.logo_light | img_url: '160x' }}" alt="{{ shop.name }}" class="footer-logo">
    {% else %}
      <span style="font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:4px;color:rgba(255,255,255,.35);">{{ shop.name }}</span>
    {% endif %}
  </a>
  <div class="footer-links">
    {% for block in section.blocks %}
      <a href="{{ block.settings.url }}" class="footer-link" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
    {% endfor %}
  </div>
  <div class="footer-copy">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'AERON Sportswear' }} &mdash; {{ section.settings.location | default: 'Montréal' }}</div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "AERON Sportswear" },
    { "type": "text", "id": "location",   "label": "City",        "default": "Montréal" }
  ],
  "blocks": [{ "type": "link", "name": "Footer Link", "settings": [
    { "type": "text", "id": "label", "label": "Label" },
    { "type": "url",  "id": "url",   "label": "URL" }
  ]}],
  "presets": [{"name": "Footer", "blocks": [
    { "type": "link", "settings": { "label": "Kits",            "url": "/pages/kits" } },
    { "type": "link", "settings": { "label": "Grip Socks",      "url": "/collections/grip-socks" } },
    { "type": "link", "settings": { "label": "Teams",           "url": "/pages/gallery" } },
    { "type": "link", "settings": { "label": "Start a Project", "url": "/pages/kits#project" } }
  ]}]
}
{% endschema %}