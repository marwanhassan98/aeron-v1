<style>
#main-nav .aeron-btn{padding:10px 22px;font-size:10px;}
@media(max-width:900px){#main-nav .aeron-btn{display:none;}}
</style>
<nav id="main-nav">
  <a href="{{ routes.root_url }}" style="text-decoration:none;display:flex;align-items:center;">
    {% if settings.logo_dark != blank %}
      <img src="{{ settings.logo_dark | img_url: '200x' }}" alt="{{ shop.name }}" class="nav-logo" width="120" height="32">
    {% else %}
      <span style="font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:4px;color:#0F1A2B;">{{ shop.name }}</span>
    {% endif %}
  </a>
  <ul class="nav-links">
    {% for block in section.blocks %}
      <li><a href="{{ block.settings.url }}"{% if request.path == block.settings.url %} class="active"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label }}</a></li>
    {% endfor %}
  </ul>
  <div class="nav-right">
    <a href="/cart" style="font-family:'Barlow Condensed',sans-serif;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:rgba(15,26,43,.55);text-decoration:none;display:flex;align-items:center;gap:6px;transition:color .2s;" onmouseover="this.style.color='#C6A962'" onmouseout="this.style.color='rgba(15,26,43,.55)'">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      {% if cart.item_count > 0 %}<span style="font-family:'Orbitron',sans-serif;font-size:8px;font-weight:700;background:#C6A962;color:#0F1A2B;width:18px;height:18px;border-radius:50%;display:flex;align-items:center;justify-content:center;">{{ cart.item_count }}</span>{% endif %}
    </a>
    <a href="{{ section.settings.cta_url | default: '/pages/kits#project' }}" class="aeron-btn">{{ section.settings.cta_label | default: 'Start a Project' }}</a>
    <button class="burger-btn" id="burgerBtn" onclick="toggleMenu()" aria-label="Menu"><span></span><span></span><span></span></button>
  </div>
</nav>
<div style="height:70px;"></div>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "cta_label", "label": "CTA button text", "default": "Start a Project" },
    { "type": "url",  "id": "cta_url",   "label": "CTA button URL" }
  ],
  "blocks": [{ "type": "nav_link", "name": "Nav Link", "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Kits" },
    { "type": "url",  "id": "url",   "label": "URL" }
  ]}],
  "presets": [{"name": "Header", "blocks": [
    { "type": "nav_link", "settings": { "label": "Kits",       "url": "/pages/kits" } },
    { "type": "nav_link", "settings": { "label": "Grip Socks", "url": "/collections/grip-socks" } },
    { "type": "nav_link", "settings": { "label": "Teams",      "url": "/pages/gallery" } }
  ]}]
}
{% endschema %}