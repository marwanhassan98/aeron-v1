      {
        "type": "text",
        "id": "offer_timeline",
        "label": "Timeline",
        "default": "4–5 weeks, design included"
      }
    ]
  },
  {
    "name": "Newsletter popup",
    "settings": [
      {
        "type": "checkbox",
        "id": "popup_enabled",
        "label": "Show popup",
        "default": true
      },
      {
        "type": "text",
        "id": "popup_heading",
        "label": "Heading",
