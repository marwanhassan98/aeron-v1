      {
        "type": "url",
        "id": "instagram",
        "label": "Instagram URL"
      }
    ]
  },
  {
    "name": "Offer",
    "settings": [
      {
        "type": "paragraph",
        "content": "Used on the kits page, CTA banners and the gallery page. Change the offer here once."
      },
      {
        "type": "text",
        "id": "offer_deposit",
        "label": "Deposit",
        "default": "50%"
