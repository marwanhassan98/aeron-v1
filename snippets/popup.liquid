{%- comment -%}
  Newsletter popup. Posts a normal Shopify customer form; the discount code is only
  revealed after Shopify confirms the signup (form.posted_successfully?).
{%- endcomment -%}
<div id="popup-overlay" data-delay="{{ settings.popup_delay | default: 8 }}" hidden>
  <div id="popup-box" role="dialog" aria-modal="true" aria-labelledby="popup-title">
    <button type="button" id="popup-close" aria-label="{{ 'popup.close' | t }}">&#215;</button>
    {%- form 'customer', id: 'popup-newsletter-form' -%}
      {%- if form.posted_successfully? -%}
        <span data-popup-autoopen hidden></span>
        <div id="pu-success" style="text-align:center;padding:44px 36px;">
          <div style="width:46px;height:46px;border-radius:50%;background:linear-gradient(135deg,#A88B4A,#E8C97A);display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
            <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0F1A2B" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          </div>
          <h2 id="popup-title" style="font-family:'Orbitron',sans-serif;font-size:15px;font-weight:700;text-transform:uppercase;letter-spacing:2px;color:#0F1A2B;margin-bottom:8px;">{{ 'popup.success_title' | t }}</h2>
          {%- if settings.popup_code != blank -%}
            <p style="font-family:'Barlow Condensed',sans-serif;font-size:15px;color:rgba(15,26,43,.7);margin-bottom:14px;">{{ 'popup.success_code_html' | t: code: settings.popup_code }}</p>
          {%- else -%}
            <p style="font-family:'Barlow Condensed',sans-serif;font-size:15px;color:rgba(15,26,43,.7);margin-bottom:14px;">{{ 'popup.success_text' | t }}</p>
          {%- endif -%}
          <button type="button" data-popup-dismiss class="pu-text-btn" style="margin:0 auto;">{{ 'popup.continue' | t }}</button>
        </div>
      {%- else -%}
        {%- if form.errors -%}<span data-popup-autoopen hidden></span>{%- endif -%}
        <div id="pu-form-wrap" style="padding:44px 42px 34px;">
          <div class="kicker" style="margin-bottom:10px;">{{ 'popup.kicker' | t }}</div>
          <h2 id="popup-title" style="font-family:'Orbitron',sans-serif;font-weight:900;font-size:clamp(20px,5vw,30px);line-height:.92;text-transform:uppercase;color:#0F1A2B;margin-bottom:10px;">{{ settings.popup_heading }}</h2>
          <p style="font-family:'Barlow Condensed',sans-serif;font-size:15px;color:rgba(15,26,43,.66);margin-bottom:22px;line-height:1.55;">{{ settings.popup_text }}</p>
          <input type="hidden" name="contact[tags]" value="newsletter,popup">
          <div style="display:flex;">
            <label class="visually-hidden" for="popupEmail">{{ 'popup.email' | t }}</label>
            <input type="email" name="contact[email]" id="popupEmail" placeholder="your@email.com" required autocomplete="email" class="f-input" style="flex:1;min-width:0;border-right:none;">
            <button type="submit" class="aeron-btn" style="padding:13px 18px;white-space:nowrap;border-radius:0;animation:none;background:#0F1A2B;color:#E8C97A;">{{ 'popup.submit' | t }}</button>
          </div>
          {%- if form.errors -%}
            <div role="alert" style="font-family:'Barlow Condensed',sans-serif;font-size:13px;color:#B33A3A;margin-top:8px;">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <p style="font-family:'Barlow',sans-serif;font-size:11px;color:rgba(15,26,43,.66);margin-top:10px;text-align:center;">{{ 'popup.fine_print' | t }}</p>
          <button type="button" data-popup-dismiss class="pu-text-btn">{{ 'popup.no_thanks' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>
